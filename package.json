{
  "name": "kane-judge",
  "version": "0.2.0",
  "description": "Judge hackathon projects by using their live demos, and pre-flight your own: claims become Kane CLI browser tests, and every verdict points at evidence. A Claude Code plugin.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "kane-judge": "dist/kane-judge.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "skills/",
    "commands/",
    "hooks/",
    "policies/",
    ".claude-plugin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "kane-cli",
    "testmu",
    "hackathon",
    "judging",
    "e2e",
    "browser-testing",
    "ai-agents"
  ],
  "dependencies": {
    "fflate": "0.8.3",
    "picomatch": "4.0.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/picomatch": "4.0.2",
    "esbuild": "0.27.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaranSinghBisht/kane-judge.git"
  },
  "homepage": "https://github.com/KaranSinghBisht/kane-judge"
}
