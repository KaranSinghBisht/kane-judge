{
  "name": "kane-judge",
  "version": "0.3.0",
  "description": "Judge hackathon projects by using their live demos, and pre-flight your own: claims become Kane CLI browser tests, and every verdict points at evidence. A Claude Code plugin.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "kane-judge": "dist/kane-judge.mjs"
  },
  "files": [
    "dist/",
    "bin/",
    "skills/",
    "commands/",
    "hooks/",
    "policies/",
    "examples/judged/inkwell-shop/*.json",
    "examples/judged/inkwell-shop/*.yaml",
    "examples/judged/inkwell-shop/*.md",
    "examples/judged/inkwell-shop/scorecard.html",
    "examples/judged/inkwell-shop/packs/*.evidence",
    "examples/judged/inkwell-shop/flows/*_test.md",
    "examples/judged/inkwell-shop/evidence/*.{png,jpg}",
    "examples/judged/inkwell-shop/evidence/*-steps/*.{png,jpg}",
    ".claude-plugin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build:site",
    "audit:mutations": "node scripts/audit-mutations.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:browser": "node scripts/check-browser.mjs"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "kane-cli",
    "testmu",
    "hackathon",
    "judging",
    "e2e",
    "browser-testing",
    "ai-agents"
  ],
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/picomatch": "4.0.2",
    "esbuild": "0.27.0",
    "fflate": "0.8.3",
    "picomatch": "4.0.7",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KaranSinghBisht/kane-judge.git"
  },
  "homepage": "https://github.com/KaranSinghBisht/kane-judge"
}
