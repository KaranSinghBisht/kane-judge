{
  "description": "Guards Kane's recorded files and reminds the agent once per run to turn the latest results into a scorecard that passed the evidence checks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/kane-judge.mjs\" hook guard",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/kane-judge.mjs\" hook stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
